# Copia in .streamlit/secrets.toml e compila
drive_folder_id = "ID_DELLA_CARTELLA"   # parte finale dell'URL: drive.google.com/drive/folders/<ID>

# OPZIONE A (consigliata se le chiavi di service account sono bloccate): OAuth col tuo account
[oauth]
client_id = "..."
client_secret = "..."
refresh_token = "..."

# OPZIONE B: service account (usa solo se puoi creare chiavi)
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "nome@progetto.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
